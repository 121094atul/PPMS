<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ModSecurity / WAF disable karne ke liye -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="30000000" maxQueryString="4096" maxUrl="4096" />
        <verbs allowUnlisted="true" />
        <fileExtensions allowUnlisted="true" />
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ASP.NET Core ke liye standard IIS handler -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <!-- hostingModel="outofprocess" jaanbujh kar hai, inprocess nahi.

         Shared hosting (HostingRaja) par client (ppms) aur API (ppmsapi) dono ek
         hi IIS Application Pool me chalte hain, aur alag pool lene ka option
         hosting plan me band hai. In-process hosting ek pool me do ASP.NET Core
         app nahi chalne deta — usse ye milta tha:
             HTTP Error 500.35 - ASP.NET Core does not support multiple apps
                                 in the same app pool
         Out-of-process me IIS sirf reverse proxy ka kaam karta hai aur har app
         apna Kestrel chalati hai, isliye ek pool me kai app chal jaate hain.

         Thoda dheema hota hai (har request ek extra hop leti hai), par is
         hosting par yahi chalega. Aage kabhi dedicated pool mil jaye to isko
         wapas "inprocess" kar dena — tab thoda tez ho jayega. -->
    <aspNetCore processPath="dotnet"
                arguments=".\PPMS.Api.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="outofprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
