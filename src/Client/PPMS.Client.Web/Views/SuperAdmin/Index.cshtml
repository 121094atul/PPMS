@model PPMS.Client.Web.Models.TenantListViewModel
@using PPMS.Client.Web.Services
@{
    ViewData["Title"] = "Tenant Subscriptions";
    var subRequests = Model.Requests;
    var pendingCount = subRequests.Count(r => r.Status == "PENDING");
    // List par wapas aane ke liye - har form me yahi chaar chhupe khaane.
    var keep = new Dictionary<string, string?>
    {
        ["q"] = Model.Search, ["status"] = Model.Status, ["sort"] = Model.Sort, ["page"] = Model.PageNumber.ToString()
    };
    string PageUrl(int p) => Url.Action("Index", new { q = Model.Search, status = Model.Status, sort = Model.Sort, page = p })!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@L["Tenant Subscriptions (Super Admin)"]</h2>
    <a asp-action="CreateTenant" class="btn btn-primary">@L["Create New Tenant"]</a>
</div>

@if (TempData["SuperAdminOk"] is string okMsg)
{
    @* GetString(...).Value - sandesh me tenant ka naam ho sakta hai; @L[..] use HTML-encode nahi karta. *@
    <div class="alert alert-success py-2" style="word-break:break-word;">@L.GetString(okMsg).Value</div>
}
@if (TempData["SuperAdminMessage"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
{
    <div class="alert alert-danger py-2">@L.GetString(errMsg).Value</div>
}

@if (subRequests.Count > 0)
{
    <div class="card shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning bg-opacity-10 d-flex align-items-center justify-content-between">
            <div class="fw-bold">
                &#128276; Plan Requests
                @if (pendingCount > 0)
                {
                    <span class="badge bg-danger ms-2">@pendingCount Pending</span>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@L["Name"]</th>
                            <th>@L["Mobile"]</th>
                            <th>@L["Plan"]</th>
                            <th>@L["Requested On"]</th>
                            <th>@L["Status"]</th>
                            <th class="text-end">@L["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in subRequests)
                        {
                            <tr class="@(req.Status == "PENDING" ? "table-warning" : "")">
                                <td class="fw-semibold" data-label="@L["Name"]">@req.ContactName</td>
                                <td data-label="@L["Mobile"]">
                                    <a href="https://wa.me/91@req.ContactNo" target="_blank" class="text-success fw-bold text-decoration-none">
                                        &#128222; @req.ContactNo
                                    </a>
                                </td>
                                <td data-label="@L["Plan"]">
                                    @if (req.PlanType == "6_MONTH")
                                    {
                                        <span class="badge bg-primary">@L["6 Month Plan"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-purple" style="background:#7c3aed!important;">@L["1 Year Plan"]</span>
                                    }
                                </td>
                                <td class="text-muted" data-label="@L["Requested On"]">@req.RequestedOn.ToString("dd MMM yyyy HH:mm")</td>
                                <td data-label="@L["Status"]">
                                    @if (req.Status == "PENDING")
                                    {
                                        <span class="badge bg-warning text-dark">@L["Pending"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@L["done"]</span>
                                    }
                                </td>
                                <td class="text-end" data-label="@L["Action"]">
                                    @if (req.Status == "PENDING")
                                    {
                                        <form asp-action="MarkSubscriptionDone" asp-route-id="@req.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" data-confirm="Mark this request as done?"
                                                    data-confirm-title="@L["Mark as done"]"
                                                    data-confirm-ok="Mark done">
                                                &#10003; Done
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ---- Section AX: search + filter + sort - sab server par ---- *@
<form method="get" asp-action="Index" class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label class="form-label small mb-1" for="tenantSearch">@L["Search"]</label>
                <input id="tenantSearch" name="q" value="@Model.Search" class="form-control" maxlength="100"
                       placeholder="@L["Name, mobile, username, pump, city, GSTIN or ID"]" />
            </div>
            <div class="col-7 col-md-3">
                <label class="form-label small mb-1" for="tenantSort">@L["Sort"]</label>
                <select id="tenantSort" name="sort" class="form-select">
                    <option value="NEWEST" selected="@(Model.Sort == "NEWEST")">@L["Newest first"]</option>
                    <option value="OLDEST" selected="@(Model.Sort == "OLDEST")">@L["Oldest first"]</option>
                    <option value="NAME" selected="@(Model.Sort == "NAME")">@L["Name (A-Z)"]</option>
                    <option value="VALIDUPTO" selected="@(Model.Sort == "VALIDUPTO")">@L["Plan ends soonest"]</option>
                    <option value="LASTENTRY" selected="@(Model.Sort == "LASTENTRY")">@L["Latest entry first"]</option>
                </select>
            </div>
            <div class="col-5 col-md-3 d-flex gap-2">
                <input type="hidden" name="status" value="@Model.Status" />
                <button type="submit" class="btn btn-primary flex-fill">@L["Search"]</button>
                @if (Model.Search is not null)
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { status = Model.Status, sort = Model.Sort })" title="@L["Clear"]">&times;</a>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap gap-1 mt-2">
            @foreach (var chip in Model.StatusChips())
            {
                var on = chip.Key == Model.Status;
                <a href="@Url.Action("Index", new { q = Model.Search, status = chip.Key, sort = Model.Sort })"
                   class="btn btn-sm @(on ? (chip.Key == "ARCHIVED" ? "btn-secondary" : "btn-primary") : "btn-outline-secondary")">
                    @L[chip.Label] @if (chip.Count is not null) { <span class="badge @(on ? "bg-light text-dark" : "bg-secondary") ms-1">@chip.Count</span> }
                </a>
            }
        </div>
    </div>
</form>

@if (Model.IsArchivedView)
{
    <div class="alert alert-secondary py-2 small">
        @L["Removed tenants cannot sign in, but all their data is still kept. Restore brings one back (suspended). Delete for ever removes all its data - a backup file is saved on the server first, and it is allowed only if there was no entry in the last 15 days."]
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white small text-muted d-flex justify-content-between flex-wrap gap-2">
        <span>
            @if (Model.TotalCount == 0)
            {
                @L["No tenants found."]
            }
            else
            {
                @string.Format(L.GetString("Showing {0}-{1} of {2}").Value, Model.FirstRow, Model.LastRow, Model.TotalCount)
            }
        </span>
        @if (Model.Search is not null)
        {
            <span>@L["Search"]: <strong>@Model.Search</strong></span>
        }
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@L["ID"]</th>
                        <th>@L["Tenant Name"]</th>
                        <th>@L["Contact"]</th>
                        <th>@L["Valid Upto (Trial)"]</th>
                        @* Ye teen batate hain ki grahak SACH ME chala raha hai ya nahi.
                           50 pump ho jayen to sabse zaroori sawaal yahi hai - kise
                           call karna hai aur kis trial ko badhane ka matlab hai. *@
                        <th>@L["Last Login"]</th>
                        <th>@L["Last Entry"]</th>
                        <th class="text-end">@L["Sales (This Month)"]</th>
                        <th>@L["Status"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count > 0)
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td data-label="@L["ID"]">@item.Id</td>
                                <td data-label="@L["Tenant Name"]">
                                    <div class="fw-semibold">@item.Name</div>
                                    <div class="small text-muted">
                                        @(item.City ?? "-")
                                        @if (item.IsTrial) { <span class="badge bg-warning text-dark ms-1">@L["TRIAL"]</span> }
                                        <span class="ms-1">· @item.PumpCount @L["pump"] · @item.UserCount @L["users"]</span>
                                    </div>
                                </td>
                                <td data-label="@L["Contact"]">
                                    <div>@(item.ContactName ?? "-")</div>
                                    @if (!string.IsNullOrWhiteSpace(item.ContactNo))
                                    {
                                        <a class="small" href="tel:@item.ContactNo">@item.ContactNo</a>
                                    }
                                </td>
                                <td data-label="@L["Valid Upto"]">
                                    @if (item.ValidUpto is null)
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                    else if (item.ValidUpto.Value.Date >= DateTime.Today)
                                    {
                                        <span class="text-success fw-bold">@item.ValidUpto.Value.ToString("dd MMM yyyy")</span>
                                        @if (item.DaysLeft is <= 7) { <div class="small text-warning">@item.DaysLeft @L["days left"]</div> }
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">@item.ValidUpto.Value.ToString("dd MMM yyyy") (@L["Expired"])</span>
                                    }
                                </td>
                                @{
                                    // Entry band ho jana chhodne ki sabse pehli nishani hai.
                                    var daysSinceEntry = item.LastActivityOn.HasValue
                                        ? (int?)(DateTime.Today - item.LastActivityOn.Value.Date).TotalDays
                                        : null;
                                }
                                <td data-label="@L["Last Login"]">
                                    @if (item.LastLoginOn.HasValue)
                                    {
                                        <span class="small">@item.LastLoginOn.Value.ToString("dd MMM, HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@L["Never"]</span>
                                    }
                                </td>
                                <td data-label="@L["Last Entry"]">
                                    @if (daysSinceEntry is null)
                                    {
                                        <span class="badge bg-danger">@L["No entries"]</span>
                                    }
                                    else if (daysSinceEntry > 7)
                                    {
                                        <span class="badge bg-danger">@daysSinceEntry @L["days ago"]</span>
                                    }
                                    else if (daysSinceEntry > 2)
                                    {
                                        <span class="badge bg-warning text-dark">@daysSinceEntry @L["days ago"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@(daysSinceEntry == 0 ? L["Today"].Value : daysSinceEntry + " " + L["days ago"].Value)</span>
                                    }
                                </td>
                                <td class="text-end" data-label="@L["Sales (This Month)"]">
                                    @(item.SalesThisMonth > 0 ? "₹" + item.SalesThisMonth.ToString("N0") : "-")
                                </td>
                                <td data-label="@L["Status"]">
                                    @if (item.IsArchived)
                                    {
                                        <span class="badge bg-secondary">@L["Removed"]</span>
                                        @if (item.ArchivedOn.HasValue) { <div class="small text-muted">@item.ArchivedOn.Value.ToString("dd MMM yyyy")</div> }
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="badge bg-success">@L["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@L["Suspended"]</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap" data-label="@L["Actions"]">
                                    @* Naam / id data- me - onclick me naam likhne se naam ke ' ya script se
                                       Super Admin ke browser me code chal sakta tha (naam self-signup wala likhta hai). *@
                                    @if (item.IsArchived)
                                    {
                                        <form asp-action="Archive" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="archive" value="false" />
                                            @foreach (var k in keep) { <input type="hidden" name="@k.Key" value="@k.Value" /> }
                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                    data-confirm="@L["Bring this tenant back? It stays suspended until you press Activate."]"
                                                    data-confirm-title="@L["Restore tenant"]"
                                                    data-confirm-ok="@L["Restore"]">@L["Restore"]</button>
                                        </form>
                                        <a class="btn btn-sm btn-outline-primary ms-1" asp-action="ExportTenant" asp-route-id="@item.Id">@L["Download data"]</a>
                                        <button type="button" class="btn btn-sm btn-danger ms-1 js-purge"
                                                data-id="@item.Id" data-name="@item.Name">@L["Delete for ever"]</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary js-extend"
                                                data-id="@item.Id" data-name="@item.Name"
                                                data-valid="@(item.ValidUpto?.ToString("yyyy-MM-dd") ?? "")">@L["Extend Trial"]</button>
                                        @* Grahak ka phone aata hai "password bhool gaya" - pehle iske
                                           liye seedha DB kholni padti thi. *@
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1 js-users"
                                                data-id="@item.Id" data-name="@item.Name">@L["Users / Password"]</button>

                                        <form asp-action="ToggleStatus" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            @foreach (var k in keep) { <input type="hidden" name="@k.Key" value="@k.Value" /> }
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="@L["Suspend this tenant? Their users will not be able to sign in."]"
                                                        data-confirm-title="@L["Suspend tenant"]"
                                                        data-confirm-ok="@L["Suspend"]"
                                                        data-confirm-danger="true">@L["Suspend"]</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" data-confirm="@L["Activate this tenant?"]"
                                                        data-confirm-title="@L["Activate tenant"]"
                                                        data-confirm-ok="@L["Activate"]">@L["Activate"]</button>
                                            }
                                        </form>

                                        <form asp-action="Archive" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="archive" value="true" />
                                            @foreach (var k in keep) { <input type="hidden" name="@k.Key" value="@k.Value" /> }
                                            <button type="submit" class="btn btn-sm btn-outline-dark"
                                                    data-confirm="@L["Remove this tenant? It goes off the list and its users cannot sign in. All data is kept - you can restore it later from Removed."]"
                                                    data-confirm-title="@L["Remove tenant"]"
                                                    data-confirm-ok="@L["Remove"]"
                                                    data-confirm-danger="true">@L["Remove"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">@L["No tenants found."]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.TotalPages > 1)
    {
        var from = Math.Max(1, Model.PageNumber - 2);
        var to = Math.Min(Model.TotalPages, Model.PageNumber + 2);
        <div class="card-footer bg-white">
            <nav aria-label="@L["Pages"]">
                <ul class="pagination pagination-sm justify-content-center flex-wrap mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@PageUrl(Model.PageNumber - 1)">&laquo; @L["Previous"]</a>
                    </li>
                    @if (from > 1)
                    {
                        <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                        @if (from > 2) { <li class="page-item disabled"><span class="page-link">&hellip;</span></li> }
                    }
                    @for (var p = from; p <= to; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")"><a class="page-link" href="@PageUrl(p)">@p</a></li>
                    }
                    @if (to < Model.TotalPages)
                    {
                        @if (to < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">&hellip;</span></li> }
                        <li class="page-item"><a class="page-link" href="@PageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@PageUrl(Model.PageNumber + 1)">@L["Next"] &raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Poora mitao: naam type karke -->
<div class="modal fade" id="purgeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="PurgeTenant" method="post" id="purgeForm">
                <input type="hidden" name="id" id="purgeId" />
                @foreach (var k in keep) { <input type="hidden" name="@k.Key" value="@k.Value" /> }
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">@L["Delete tenant for ever"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2"><strong id="purgeName"></strong></p>
                    <ul class="small mb-3">
                        <li>@L["All its pumps, shifts, sales, purchases, parties, staff, users and every other entry will be deleted. This cannot be undone."]</li>
                        <li>@L["A backup file of all its data is saved on the server first. If that fails, nothing is deleted."]</li>
                        <li>@L["Not allowed if it had any entry in the last 15 days."]</li>
                    </ul>
                    <label class="form-label" for="purgeConfirm">@L["Type the tenant name to confirm"]</label>
                    <input class="form-control" id="purgeConfirm" name="confirmName" autocomplete="off" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-danger" id="purgeGo" disabled>@L["Delete for ever"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Tenant ke users + password reset -->
<div class="modal fade" id="usersModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Users &mdash; <span id="usersTenantName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="usersLoading" class="text-muted small">@L["Loading..."]</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="usersTable" style="display:none;">
                        <thead class="table-light">
                            <tr>
                                <th>@L["Name"]</th>
                                <th>@L["Username"]</th>
                                <th>@L["Role"]</th>
                                <th>@L["Mobile"]</th>
                                <th>@L["Last Login"]</th>
                                <th class="text-end">@L["Action"]</th>
                            </tr>
                        </thead>
                        <tbody id="usersBody"></tbody>
                    </table>
                </div>
                <div id="usersMsg" class="alert py-2 mt-2" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Extend Trial Modal -->
<div class="modal fade" id="extendTrialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ExtendTrial" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">@L["Extend Subscription / Trial"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="extendTenantId" name="id" />
                    @foreach (var k in keep) { <input type="hidden" name="@k.Key" value="@k.Value" /> }
                    <div class="mb-3">
                        <label class="form-label">@L["Tenant Name"]</label>
                        <input type="text" id="extendTenantName" class="form-control" readonly />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label d-block">@L["Quick Select Subscription"]</label>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="setQuickDate(30, 'days')">@L["30 Days (Trial)"]</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="setQuickDate(6, 'months')">@L["6 Months"]</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="setQuickDate(1, 'years')">@L["1 Year"]</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["New Valid Upto Date"]</label>
                        <input type="date" id="newValidUpto" name="newValidUpto" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@L["Save Changes"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openExtendModal(id, name, currentValidUpto) {
            document.getElementById('extendTenantId').value = id;
            document.getElementById('extendTenantName').value = name;
            
            if (currentValidUpto) {
                document.getElementById('newValidUpto').value = currentValidUpto;
            } else {
                setQuickDate(30, 'days');   // trial ab 30 din ka hai
            }

            new bootstrap.Modal(document.getElementById('extendTrialModal')).show();
        }

        // Section AX: buttons ka naam / id data- se. Pehle onclick="openExtendModal('@@item.Name')"
        // tha - naam me ' ya script ho to Super Admin ke browser me chal jaata.
        document.addEventListener('click', function (e) {
            var b = e.target.closest('.js-extend, .js-users, .js-purge');
            if (!b) { return; }
            if (b.classList.contains('js-extend')) { openExtendModal(b.dataset.id, b.dataset.name, b.dataset.valid); }
            else if (b.classList.contains('js-users')) { openUsersModal(b.dataset.id, b.dataset.name); }
            else { openPurgeModal(b.dataset.id, b.dataset.name); }
        });

        // "Poora mitao": button tabhi chalu jab naam theek type ho (server bhi jaanchta hai).
        var purgeExpected = '';
        // Server jaisa hi: aage-peeche ki khaali jagah hata ke, bade-chhote akshar ka farak nahi.
        function normName(v) { return String(v || '').trim().toUpperCase(); }
        function openPurgeModal(id, name) {
            purgeExpected = normName(name);
            document.getElementById('purgeId').value = id;
            document.getElementById('purgeName').textContent = name;
            document.getElementById('purgeConfirm').value = '';
            document.getElementById('purgeGo').disabled = true;
            new bootstrap.Modal(document.getElementById('purgeModal')).show();
        }
        document.getElementById('purgeConfirm').addEventListener('input', function () {
            document.getElementById('purgeGo').disabled = normName(this.value) !== purgeExpected;
        });
        document.getElementById('purgeForm').addEventListener('submit', function () {
            var go = document.getElementById('purgeGo');
            go.disabled = true;   // do baar click se do request nahi
            go.textContent = @Json.Serialize(L["Deleting..."].Value);
        });

        function setQuickDate(amount, unit) {
            let d = new Date();
            if (unit === 'days') {
                d.setDate(d.getDate() + amount);
            } else if (unit === 'months') {
                d.setMonth(d.getMonth() + amount);
            } else if (unit === 'years') {
                d.setFullYear(d.getFullYear() + amount);
            }
            document.getElementById('newValidUpto').value = d.toISOString().split('T')[0];
        }
    
    // ── Tenant ke users + password reset ────────────────────────────────
    var usersModalOwnerId = null;

    function openUsersModal(ownerId, name) {
        usersModalOwnerId = ownerId;
        document.getElementById('usersTenantName').textContent = name;
        document.getElementById('usersBody').innerHTML = '';
        document.getElementById('usersTable').style.display = 'none';
        document.getElementById('usersLoading').style.display = 'block';
        document.getElementById('usersMsg').style.display = 'none';

        new bootstrap.Modal(document.getElementById('usersModal')).show();

        fetch('/SuperAdmin/TenantUsers?ownerId=' + ownerId)
            .then(function (r) { return r.json(); })
            .then(function (users) {
                var body = document.getElementById('usersBody');
                body.innerHTML = '';

                users.forEach(function (u) {
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' + esc(u.fullName) + (u.isOwner ? ' <span class="badge bg-primary">@L["Owner"]</span>' : '') + '</td>' +
                        '<td><code>' + esc(u.username) + '</code></td>' +
                        '<td>' + esc(u.roleName) + '</td>' +
                        '<td>' + esc(u.mobile || '-') + '</td>' +
                        '<td class="small">' + (u.lastLoginOn ? new Date(u.lastLoginOn).toLocaleString() : '@L["Never"]') + '</td>' +
                        '<td class="text-end"><button class="btn btn-sm btn-outline-warning" ' +
                        'onclick="resetUserPassword(' + u.id + ', \'' + esc(u.username) + '\')">@L["Reset password"]</button></td>';
                    body.appendChild(tr);
                });

                document.getElementById('usersLoading').style.display = 'none';
                document.getElementById('usersTable').style.display = '';
            })
            .catch(function () {
                document.getElementById('usersLoading').textContent = '@L["Could not load users."]';
            });
    }

    // Naam/username page par aata hai - HTML me daalne se pehle saaf karna zaroori.
    function esc(v) {
        return String(v == null ? '' : v)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function showUsersMsg(text, isError) {
        var el = document.getElementById('usersMsg');
        el.textContent = text;
        el.className = 'alert py-2 mt-2 ' + (isError ? 'alert-danger' : 'alert-success');
        el.style.display = 'block';
    }

    // Pehle yahan browser ka prompt() tha, aur uska sawaal Hinglish me likha tha.
    // Do aur dikkatein thin: password type karte waqt akshar khule dikhte the,
    // aur "6 se chhota" wali galti modal band hone ke BAAD batani padti thi —
    // user ko poora password dobara likhna padta tha.
    // Ab site.js ka ppmsPrompt hai: password field chhupa hua, aur lambai ki
    // jaanch usi box me ho jaati hai.
    function resetUserPassword(userId, username) {
        window.ppmsPrompt(@Json.Serialize(L["New password for"].Value) + ' "' + username + '"', {
            title: @Json.Serialize(L["Reset password"].Value),
            okText: @Json.Serialize(L["Reset password"].Value),
            password: true,
            minLength: 6,
            errorText: @Json.Serialize(L["Password must be at least 6 characters."].Value)
        }).then(function (pwd) {
            if (pwd === null) { return; }   // Cancel dabaya
            sendResetPassword(userId, username, pwd);
        });
    }

    function sendResetPassword(userId, username, pwd) {
        // ppmsFetch = fetch + CSRF token header (site.js me hai)
        ppmsFetch('/SuperAdmin/ResetUserPassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: userId, newPassword: pwd })
        })
        .then(function (r) {
            if (r.ok) {
                // Password screen par dikhate hain kyunki superadmin ko grahak ko
                // phone par batana hota hai. Kahin store nahi hota.
                showUsersMsg('Done. New password for "' + username + '": ' + pwd + ' — please pass it on to the customer.', false);
            } else {
                showUsersMsg('Could not reset the password.', true);
            }
        })
        .catch(function () { showUsersMsg('Network problem.', true); });
    }
</script>
}
