@model PPMS.Client.Web.Services.ApiNotifySettings
@{
    ViewData["Title"] = "Message Settings";
    string Sel(string current, string value) => string.Equals(current, value, StringComparison.OrdinalIgnoreCase) ? "selected" : "";
}

@if (TempData["SuperAdminOk"] is string okMsg)
{
    <div class="alert alert-success py-2 small">@L.GetString(okMsg).Value</div>
}
@if (TempData["SuperAdminMessage"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
{
    <div class="alert alert-danger py-2 small">@L.GetString(errMsg).Value</div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-1">✉️ @L["Message Settings"]</h5>
                <p class="text-muted small mb-3">
                    @L["Choose how the password OTP and the owner alerts are sent. The change works right away - no deploy needed."]
                </p>

                <form method="post" asp-action="MessageSettings">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="otpChannel">@L["Password reset OTP"]</label>
                        <select class="form-select" id="otpChannel" name="otpChannel">
                            <option value="EMAIL" selected="@(Sel(Model.OtpChannel, "EMAIL") != "")">@L["Email (free)"]</option>
                            <option value="PROVIDER" selected="@(Sel(Model.OtpChannel, "PROVIDER") != "")">@L["SMS / WhatsApp (server setting)"]</option>
                            <option value="OFF" selected="@(Sel(Model.OtpChannel, "OFF") != "")">@L["Off - user calls support"]</option>
                        </select>
                        <div class="form-text">@L["By email the OTP goes to the owner's email (saved in Settings > Alerts or at sign-up). Staff logins have no email - they call support."]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="ownerAlertChannel">@L["Owner alerts (shift closed, purchase, stock loss, bank deposit, large expense, party entry)"]</label>
                        <select class="form-select" id="ownerAlertChannel" name="ownerAlertChannel">
                            <option value="EMAIL" selected="@(Sel(Model.OwnerAlertChannel, "EMAIL") != "")">@L["Email (free, no credit used)"]</option>
                            <option value="PROVIDER" selected="@(Sel(Model.OwnerAlertChannel, "PROVIDER") != "")">@L["SMS / WhatsApp (server setting, uses credit)"]</option>
                        </select>
                        <div class="form-text">@L["The message to the credit party and the sign-up welcome always go by SMS / WhatsApp."]</div>
                    </div>

                    <button type="submit" class="btn btn-primary">@L["Save"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small mb-2">@L["Email on the server"]</h6>
                @if (Model.EmailConfigured)
                {
                    <div class="text-success fw-semibold mb-1">✔ @L["Set up"]</div>
                    <div class="small text-muted mb-3">@L["Sent from"]: <strong>@Model.EmailFrom</strong></div>
                }
                else
                {
                    <div class="text-danger fw-semibold mb-1">✖ @L["Not set up"]</div>
                    <div class="small text-muted mb-3">
                        @L["Until then nothing goes by email. On the server set:"]
                        <code class="d-block mt-1">Email__Host, Email__Port, Email__Username, Email__Password, Email__From</code>
                    </div>
                }

                <form method="post" asp-action="TestEmail" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="email" name="to" class="form-control" required maxlength="100" placeholder="@L["Your email"]" />
                    <button type="submit" class="btn btn-outline-primary text-nowrap">@L["Send test"]</button>
                </form>
            </div>
        </div>
    </div>

    @* Section BA: roz ka backup email par. Purani API par null - tab ye hissa nahi. *@
    @if (ViewBag.Backup is PPMS.Client.Web.Services.ApiBackupEmail b)
    {
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-1">🗄️ @L["Daily backup by email"]</h5>
                    <p class="text-muted small mb-3">
                        @L["Every day the full data of all pumps comes to this email as a zip file. On the shared server the database cannot make its own backup, so this is your backup - keep the emails."]
                    </p>

                    <form method="post" asp-action="SaveBackupEmail">
                        @Html.AntiForgeryToken()
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="bkEnabled" name="enabled" value="true" @(b.Enabled ? "checked" : "") />
                            <input type="hidden" name="enabled" value="false" />
                            <label class="form-check-label" for="bkEnabled">@L["Send the backup every day"]</label>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-7">
                                <label class="form-label" for="bkTo">@L["Send to"]</label>
                                <input type="email" class="form-control" id="bkTo" name="emailTo" value="@b.EmailTo" maxlength="100"
                                       placeholder="@(b.SendsTo ?? "")" />
                                <div class="form-text">@L["Leave blank to send to the Gmail that sends the mails."]</div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label" for="bkHour">@L["After (India time)"]</label>
                                <select class="form-select" id="bkHour" name="hour">
                                    @for (var h = 0; h < 24; h++)
                                    {
                                        <option value="@h" selected="@(h == b.Hour)">@(new DateTime(2000, 1, 1, h, 0, 0).ToString("hh:00 tt"))</option>
                                    }
                                </select>
                                <div class="form-text">@L["The server sleeps at night - it goes the first time the software is used after this time."]</div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">@L["Save"]</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">@L["Last backup"]</h6>
                    @if (b.LastSuccessDate.HasValue)
                    {
                        <div class="fw-semibold @(b.LastSuccessDate.Value.Date >= DateTime.Today.AddDays(-1) ? "text-success" : "text-danger") mb-1">
                            ✔ @b.LastSuccessDate.Value.ToString("dd MMM yyyy")
                        </div>
                    }
                    else
                    {
                        <div class="text-danger fw-semibold mb-1">✖ @L["No backup has been sent yet"]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(b.LastStatus))
                    {
                        <div class="small text-muted mb-3" style="word-break:break-word;">@b.LastStatus</div>
                    }
                    <div class="small mb-3">@L["Goes to"]: <strong>@(b.SendsTo ?? "-")</strong></div>
                    <form method="post" asp-action="SendBackupNow">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary" @(b.EmailConfigured ? "" : "disabled")>@L["Send backup now"]</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
