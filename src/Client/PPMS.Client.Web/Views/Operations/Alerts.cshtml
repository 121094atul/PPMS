@model PPMS.Client.Web.Models.OwnerAlertViewModel
@{
    ViewData["Title"] = "Alert Settings";
    var hasMobile = !string.IsNullOrWhiteSpace(Model.Mobile);
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-1">@L["Alert number"]</h5>
                <p class="text-muted small mb-3">
                    @L["Alerts about your pump — shift closed, stock loss, big expenses — go to this number."]
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success") alert-dismissible fade show py-2 small" role="alert">
                        @Model.Message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button>
                    </div>
                }

                @if (!hasMobile)
                {
                    @* Ye sabse zaroori baat hai — number ke bina kuch bhi nahi jayega,
                       aur user ko iska koi ishaara kahin aur nahi milta. *@
                    <div class="alert alert-warning py-2 px-2 small">
                        @L["No number is set, so no alerts are being sent at the moment."]
                    </div>
                }

                <form method="post" asp-action="SaveAlertMobile">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label" for="alertMobile">@L["Mobile number"]</label>
                        <input id="alertMobile" name="mobile" value="@Model.Mobile"
                               class="form-control form-control-sm" inputmode="tel"
                               placeholder="@L["10-digit mobile number"]" />
                        <div class="form-text">@L["Leave it blank to stop all alerts."]</div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm px-4">@L["Save number"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-1">@L["Which alerts do you want?"]</h5>
                <p class="text-muted small mb-3">
                    @L["Turn off the ones you do not need. Each message you receive costs money, so fewer alerts means a smaller bill."]
                </p>

                <div class="table-responsive">
                    <table data-pager="25" class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>@L["Alert"]</th>
                                <th class="text-end">@L["Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Alerts)
                            {
                                <tr>
                                    <td data-label="@L["Alert"]">
                                        <div class="fw-semibold">@a.Title</div>
                                        <div class="text-muted small">@a.Description</div>
                                    </td>
                                    <td class="text-end" data-label="@L["Status"]">
                                        @* Har switch apna chhota form hai — ek toggle, ek save.
                                           Isse JS ki zaroorat nahi padti aur CSRF token bhi
                                           apne aap chala jaata hai. *@
                                        <form method="post" asp-action="SaveAlertSetting" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="alertKey" value="@a.AlertKey" />
                                            <input type="hidden" name="isEnabled" value="@((!a.IsEnabled).ToString().ToLowerInvariant())" />
                                            @if (a.IsEnabled)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success" title="@L["Click to turn off"]">
                                                    @L["On"]
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@L["Click to turn on"]">
                                                    @L["Off"]
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-muted small mt-2">
                    @L["Right now these go out as SMS. WhatsApp can be switched on later without changing anything here."]
                </div>
            </div>
        </div>
    </div>
</div>
