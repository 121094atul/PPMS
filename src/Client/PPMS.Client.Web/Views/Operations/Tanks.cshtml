@model PPMS.Client.Web.Models.TankManagementViewModel
@{
    ViewData["Title"] = "Tank Management";
}

<div class="row g-3">
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title mb-1">@L["Tank Form"]</h5>
                <p class="text-muted small mb-3">@L["Configure underground/overhead tank details by pump and product."]</p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-info alert-dismissible fade show py-2" role="alert">@Model.Message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div>
                }

                <form asp-action="SaveTank" asp-controller="Operations" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Form.Id" type="hidden" />
                    <input asp-for="Form.OwnerId" type="hidden" />

                    <div class="mb-2">
                        <label class="form-label">@L["Pump"]</label>
                        <select asp-for="Form.PumpId" class="form-select" required onchange="window.location='/Operations/Tanks?pumpId='+this.value">
                            @foreach (var pump in Model.Pumps)
                            {
                                <option value="@pump.Id">@pump.Name (@pump.City)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@L["Tank Name"]</label>
                        <input asp-for="Form.Name" class="form-control" placeholder="@L["Tank A"]" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@L["Product"]</label>
                        <select asp-for="Form.ProductId" class="form-select" required>
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">@product.Name (@product.Category)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">@L["Capacity"]</label>
                            <input asp-for="Form.Capacity" type="number" class="form-control" step="0.01" min="0" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Safe Fill Level"]</label>
                            <input asp-for="Form.SafeFillLevel" type="number" class="form-control" step="0.01" min="0" required />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@L["Current Stock"]</label>
                        <input asp-for="Form.CurrentStock" type="number" class="form-control" step="0.01" min="0" required />
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Form.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Form.IsActive" class="form-check-label">@L["Active"]</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">@(Model.Form.Id == 0 ? L["Create Tank"].Value : L["Update Tank"].Value)</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">@L["Tank List"]</h5>
                    <form method="get" asp-action="Tanks" asp-controller="Operations" class="d-flex gap-2">
                        <input type="hidden" name="pumpId" value="@Model.Form.PumpId" />
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="@L["Search tank"]" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Search"]</button>
                    </form>
                </div>

                <div class="table-responsive">
                    <table data-pager="25" class="table table-sm align-middle">
                        <thead>
                        <tr>
                            <th>@L["Name"]</th>
                            <th>@L["Product"]</th>
                            <th>@L["Capacity"]</th>
                            <th>@L["Stock"]</th>
                            <th>@L["Status"]</th>
                            <th class="text-end">@L["Action"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Tanks.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon">&#128738;</div><div class="empty-state-title">@L["No tanks added"]</div><div class="empty-state-hint">@L["Add an underground or overhead tank and set its product and capacity."]</div></div></td></tr>
                        }
                        else
                        {
                            @foreach (var tank in Model.Tanks)
                            {
                                <tr>
                                    <td data-label="@L["Name"]">@tank.Name</td>
                                    <td data-label="@L["Product"]">@tank.ProductName</td>
                                    <td data-label="@L["Capacity"]">@tank.Capacity.ToString("0.##") @tank.Unit</td>
                                    <td data-label="@L["Stock"]">@tank.CurrentStock.ToString("0.##") @tank.Unit</td>
                                    <td data-label="@L["Status"]">@(tank.IsActive ? L["Active"].Value : L["Inactive"].Value)</td>
                                    <td class="text-end" data-label="@L["Action"]">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a class="btn btn-sm btn-outline-primary" href="/Operations/Tanks?pumpId=@Model.Form.PumpId&editId=@tank.Id">@L["Edit"]</a>
                                            <form method="post" asp-action="DeleteTank" asp-controller="Operations" class="d-inline">
                                                <input type="hidden" name="id" value="@tank.Id" />
                                                <input type="hidden" name="pumpId" value="@Model.Form.PumpId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Are you sure you want to delete this tank?">@L["Delete"]</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
