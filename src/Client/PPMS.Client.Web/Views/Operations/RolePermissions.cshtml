@model PPMS.Client.Web.Models.RolePermissionsViewModel
@{
    ViewData["Title"] = "Role Permissions";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Manage Permissions: @Model.RoleName</h4>
                <a asp-action="Roles" class="btn btn-sm btn-light">@L["Back to Roles"]</a>
            </div>
            <div class="card-body p-0">
                <form asp-action="SaveRolePermissions" method="post">
                    <input type="hidden" asp-for="RoleId" />
                    <input type="hidden" asp-for="RoleName" />

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Menu Item"]</th>
                                    <th class="text-center">@L["View"]</th>
                                    <th class="text-center">@L["Create"]</th>
                                    <th class="text-center">@L["Edit"]</th>
                                    <th class="text-center">@L["Delete"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Menus.Count; i++)
                                {
                                    <tr>
                                        <td data-label="@L["Menu Item"]">
                                            <input type="hidden" asp-for="Menus[i].MenuId" />
                                            <input type="hidden" asp-for="Menus[i].MenuName" />
                                            <input type="hidden" asp-for="Menus[i].Route" />
                                            @Model.Menus[i].MenuName
                                        </td>
                                        <td class="text-center" data-label="@L["View"]">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input" type="checkbox" asp-for="Menus[i].CanView" />
                                            </div>
                                        </td>
                                        <td class="text-center" data-label="@L["Create"]">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input" type="checkbox" asp-for="Menus[i].CanCreate" />
                                            </div>
                                        </td>
                                        <td class="text-center" data-label="@L["Edit"]">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input" type="checkbox" asp-for="Menus[i].CanEdit" />
                                            </div>
                                        </td>
                                        <td class="text-center" data-label="@L["Delete"]">
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input class="form-check-input" type="checkbox" asp-for="Menus[i].CanDelete" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white text-end">
                        <button type="submit" class="btn btn-primary px-4">@L["Save Permissions"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
