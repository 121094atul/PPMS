@section Scripts {
<script>
    // Bhasha ka chunav yaad rakhte hain, taaki har baar dobara na chunna pade.
    // localStorage na chale (private window waghairah) to bhi page chalta rahe.
    function setManualLang(lang) {
        document.body.classList.remove('man-en', 'man-hi');
        document.body.classList.add('man-' + lang);

        var en = document.getElementById('btnEn');
        var hi = document.getElementById('btnHi');
        if (en) { en.classList.toggle('active', lang === 'en'); }
        if (hi) { hi.classList.toggle('active', lang === 'hi'); }

        try { localStorage.setItem('ppms_manual_lang', lang); } catch (e) { /* koi baat nahi */ }
    }

    (function () {
        var saved = null;
        try { saved = localStorage.getItem('ppms_manual_lang'); } catch (e) { /* koi baat nahi */ }

        // Pehli baar: app ki apni bhasha ke hisaab se. Hindi chuni ho to Hindi manual.
        if (!saved) {
            saved = document.documentElement.lang && document.documentElement.lang.indexOf('hi') === 0 ? 'hi' : 'en';
        }
        setManualLang(saved);
    })();
</script>
}
