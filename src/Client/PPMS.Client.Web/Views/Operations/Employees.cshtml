@model PPMS.Client.Web.Models.EmployeeManagementViewModel
@{
    ViewData["Title"] = "Employee Management";
}

<div class="row g-3">
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@L["Employee Form"]</h5>
                <p class="text-muted small mb-3">@L["Operator/attendant master with optional login user mapping."]</p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-info alert-dismissible fade show py-2" role="alert">@Model.Message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div>
                }

                <form asp-action="SaveEmployee" asp-controller="Operations" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Form.Id" type="hidden" />
                    <input asp-for="Form.OwnerId" type="hidden" />

                    <div class="mb-2">
                        <label class="form-label">@L["Pump"]</label>
                        <select asp-for="Form.PumpId" class="form-select" onchange="window.location='/Operations/Employees?pumpId='+this.value">
                            @foreach (var p in Model.Pumps)
                            {
                                <option value="@p.Id">@p.Name (@p.City)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Employee Code"]</label>
                        <input asp-for="Form.EmployeeCode" class="form-control" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Full Name"]</label>
                        <input asp-for="Form.FullName" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Mobile"]</label>
                        <input asp-for="Form.Mobile" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Designation"]</label>
                        <input asp-for="Form.Designation" class="form-control" placeholder="@L["Operator / Manager / Cashier"]" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">@L["Join Date"]</label>
                            <input asp-for="Form.JoinDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Monthly Salary"]</label>
                            <input asp-for="Form.MonthlySalary" type="number" min="0" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Linked Login User (Optional)"]</label>
                        <select asp-for="Form.UserId" class="form-select">
                            <option value="">@L["-- Not linked --"]</option>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.FullName (@u.Username)</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Form.IsActive" class="form-check-input" />
                        <label asp-for="Form.IsActive" class="form-check-label">@L["Active"]</label>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">@((Model.Form.Id is null) ? "Create Employee" : "Update Employee")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@L["Employee List"]</h5>
                <div class="table-responsive">
                    <table data-pager="25" class="table table-sm align-middle">
                        <thead>
                        <tr>
                            <th>@L["Code"]</th>
                            <th>@L["Name"]</th>
                            <th>@L["Designation"]</th>
                            <th>@L["User Link"]</th>
                            <th class="text-end">@L["Salary"]</th>
                            <th>@L["Status"]</th>
                            <th class="text-end">@L["Action"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Employees.Count == 0)
                        {
                            <tr><td colspan="7"><div class="empty-state"><div class="empty-state-icon">&#128101;</div><div class="empty-state-title">@L["No employees added"]</div><div class="empty-state-hint">@L["Add a salesman or manager with their name and employee code."]</div></div></td></tr>
                        }
                        else
                        {
                            @foreach (var e in Model.Employees)
                            {
                                <tr>
                                    <td data-label="@L["Code"]">@e.EmployeeCode</td>
                                    <td data-label="@L["Name"]">@e.FullName</td>
                                    <td data-label="@L["Designation"]">@e.Designation</td>
                                    <td data-label="@L["User Link"]">@(string.IsNullOrWhiteSpace(e.UserName) ? "-" : e.UserName)</td>
                                    <td class="text-end" data-label="@L["Salary"]">@e.MonthlySalary.ToString("0.00")</td>
                                    <td data-label="@L["Status"]">@(e.IsActive ? L["Active"].Value : L["Inactive"].Value)</td>
                                    <td class="text-end" data-label="@L["Action"]">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a class="btn btn-sm btn-outline-primary" href="/Operations/Employees?pumpId=@Model.Form.PumpId&editId=@e.Id">@L["Edit"]</a>
                                            <form method="post" asp-action="DeleteEmployee" asp-controller="Operations" class="d-inline">
                                                <input type="hidden" name="id" value="@e.Id" />
                                                <input type="hidden" name="pumpId" value="@Model.Form.PumpId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Are you sure you want to delete this employee?">@L["Delete"]</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
