@model PPMS.Client.Web.Models.PartyManagementViewModel
@{
    ViewData["Title"] = "Party Management";
}

<div class="row g-3">
    <div class="col-xl-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title mb-1">@L["Party Form"]</h5>
                <p class="text-muted small mb-3">@L["Manage fleet and credit parties for invoicing and dues."]</p>

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="alert alert-info alert-dismissible fade show py-2" role="alert">@Model.Message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button></div>
                }

                <form asp-action="SaveParty" asp-controller="Operations" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Form.Id" type="hidden" />
                    <input asp-for="Form.OwnerId" type="hidden" />

                    <div class="mb-2">
                        <label class="form-label">@L["Pump"]</label>
                        <select asp-for="Form.PumpId" class="form-select" required onchange="window.location='/Operations/Parties?pumpId='+this.value">
                            @foreach (var pump in Model.Pumps)
                            {
                                <option value="@pump.Id">@pump.Name (@pump.City)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@L["Party Name"]</label>
                        <input asp-for="Form.PartyName" class="form-control" placeholder="@L["ABC Logistics"]" required />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">@L["Party Type"]</label>
                            <select asp-for="Form.PartyType" class="form-select">
                                <option>@L["Fleet"]</option>
                                <option>B2B</option>
                                <option>B2C</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Mobile"]</label>
                            <input asp-for="Form.Mobile" class="form-control" placeholder="9876543210" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">@L["Address"]</label>
                        <input asp-for="Form.Address" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["Email"]</label>
                        <input asp-for="Form.Email" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L["GSTIN"]</label>
                        <input asp-for="Form.GSTIN" class="form-control" />
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">@L["Credit Limit"]</label>
                            <input asp-for="Form.CreditLimit" type="number" class="form-control" step="0.01" min="0" />
                        </div>
                        <div class="col-md-6">
                            @* Nayi party me ye uska PURANA BAKI hai (software se pehle ka udhaar).
                               Edit me ye abhi ka baki hai — sirf galti sudhaarne ke liye badlein;
                               badla to farak purane baki me jaata hai, khaate ki line waise hi rehti hain. *@
                            <label class="form-label">@(Model.Form.Id == 0 ? L["Opening balance (old dues)"] : L["Current Balance"])</label>
                            <input asp-for="Form.OriginalBalance" type="hidden" />
                            <input asp-for="Form.CurrentBalance" type="number" class="form-control" step="0.01" />
                        </div>
                    </div>
                    <div class="form-text mb-2">
                        @if (Model.Form.Id == 0)
                        {
                            @L["If this party already owes you money, enter it here. It is saved as the party's opening balance."]
                        }
                        else
                        {
                            @L["Change the balance only to correct a mistake. Enter payments and credit in Party Ledger, not here."]
                        }
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Form.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Form.IsActive" class="form-check-label">@L["Active"]</label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">@(Model.Form.Id == 0 ? L["Create Party"].Value : L["Update Party"].Value)</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title mb-0">@L["Party List"]</h5>
                    <form method="get" asp-action="Parties" asp-controller="Operations" class="d-flex gap-2">
                        <input type="hidden" name="pumpId" value="@Model.Form.PumpId" />
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="@L["Search party"]" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Search"]</button>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                        <tr>
                            <th>@L["Name"]</th>
                            <th>@L["Type"]</th>
                            <th>@L["Mobile"]</th>
                            <th>@L["Balance"]</th>
                            <th>@L["Status"]</th>
                            <th class="text-end">@L["Action"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Parties.Count == 0)
                        {
                            <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon">&#129309;</div><div class="empty-state-title">@L["No parties found"]</div><div class="empty-state-hint">@L["Use the form on the left to add a credit or fleet customer."]</div></div></td></tr>
                        }
                        else
                        {
                            @foreach (var party in Model.Parties)
                            {
                                <tr>
                                    <td data-label="@L["Name"]">@party.PartyName</td>
                                    <td data-label="@L["Type"]">@party.PartyType</td>
                                    <td data-label="@L["Mobile"]">@party.Mobile</td>
                                    <td data-label="@L["Balance"]">@party.CurrentBalance.ToString("0.00")</td>
                                    <td data-label="@L["Status"]">@(party.IsActive ? L["Active"].Value : L["Inactive"].Value)</td>
                                    <td class="text-end" data-label="@L["Action"]">
                                        <div class="d-flex justify-content-end gap-1">
                                            @* Edit kholne par list usi page / usi khoj par rahe *@
                                            <a class="btn btn-sm btn-outline-primary" href="/Operations/Parties?pumpId=@Model.Form.PumpId&editId=@party.Id&pageNumber=@Model.PageNumber@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))">@L["Edit"]</a>
                                            <form method="post" asp-action="DeleteParty" asp-controller="Operations" class="d-inline">
                                                <input type="hidden" name="id" value="@party.Id" />
                                                <input type="hidden" name="pumpId" value="@Model.Form.PumpId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Are you sure you want to delete this party?">@L["Delete"]</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalPages > 1)
                {
                    var from = (Model.PageNumber - 1) * Model.PageSize + 1;
                    var to = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
                    var qs = "/Operations/Parties?pumpId=" + Model.Form.PumpId
                             + (string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))
                             + "&pageNumber=";
                    <div class="ppms-pager">
                        <span class="small text-muted">@L["Showing {0}-{1} of {2}", from, to, Model.TotalCount]</span>
                        <div class="btn-group btn-group-sm">
                            <a class="btn btn-outline-secondary @(Model.PageNumber > 1 ? "" : "disabled")" href="@(qs + (Model.PageNumber - 1))">@L["Previous"]</a>
                            <a class="btn btn-outline-secondary @(Model.PageNumber < Model.TotalPages ? "" : "disabled")" href="@(qs + (Model.PageNumber + 1))">@L["Next"]</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
