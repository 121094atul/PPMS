@model PPMS.Client.Web.Models.DailyRatesViewModel
@{
    ViewData["Title"] = "Today's Rates";
    var grouped = Model.Rates
        .Select((row, index) => new { row, index })
        .GroupBy(x => x.row.Category)
        .OrderBy(g => g.Key)
        .ToList();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

@section Styles {
<style>
    /* Rate ka input bada aur saaf ho - pump par subah jaldi me bhara jaata hai,
       aur ek galat ank poore din ki sale bigaad deta hai. */
    .rate-input {
        font-size: 1.1rem;
        font-weight: 700;
        text-align: right;
        max-width: 150px;
    }

    /* Jis line ka rate badla hai wo turant alag dikhe, taaki save se pehle
       user ek nazar me dekh le ki kya-kya badla. */
    .rate-row.is-changed { background: rgba(13, 110, 253, 0.07); }

    .rate-delta { font-size: 0.8rem; font-weight: 700; white-space: nowrap; }

    .rate-card-head {
        font-size: 0.78rem; font-weight: 700;
        letter-spacing: 0.6px; text-transform: uppercase;
    }

    /* Mobile: app ka aam table->card rule (site.css) har td ko flex bana kar
       uske andar sab kuch daayen dhakel deta hai, aur data-label se ek aur
       label line jodta hai. Rate wali screen par isse ek fuel 4 line le leta
       hai - 5 grade wale pump par poora din scroll. Yahan ek fuel = ek line
       chahiye: naam baayen, rate ka box daayen. Isliye global rules ko saaf
       override kar rahe hain (!important isi wajah se). */
    @@media screen and (max-width: 767.98px) {
        .rate-table thead { display: none; }

        .rate-table tbody tr {
            display: flex !important;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.15rem 0.5rem;
            padding: 0.6rem 0.15rem;
            border-bottom: 1px solid #f1f5f9;
            background: none;
            margin: 0;
            border-radius: 0;
            box-shadow: none;
        }

        .rate-table tbody tr:last-child { border-bottom: 0; }
        .rate-table tbody tr.is-changed { background: rgba(13,110,253,0.07); }

        .rate-table tbody td {
            display: block !important;
            padding: 0 !important;
            border: none !important;
            text-align: left !important;
        }

        /* Naam/unit ko daayen dhakelne wala global rule yahan nahi chahiye. */
        .rate-table tbody td > * {
            text-align: left !important;
            margin-left: 0 !important;
        }

        /* data-label wale extra label - naam aur number khud bata dete hain. */
        .rate-table tbody td::before { content: none !important; }

        .rate-table td[data-cell="fuel"]  { order: 1; flex: 1 1 auto; min-width: 0; }
        .rate-table td[data-cell="rate"]  { order: 2; flex: 0 0 auto; }
        .rate-table td[data-cell="prev"],
        .rate-table td[data-cell="delta"] {
            order: 3;
            flex: 0 0 auto;
            font-size: 0.78rem;
            color: #64748b;
        }

        /* Rate ka box daayen kinare, uske andar ka input right-aligned hi rahe. */
        .rate-table td[data-cell="rate"] .input-group { flex-wrap: nowrap; }
        .rate-table td[data-cell="rate"] .rate-input {
            text-align: right !important;
            max-width: 110px;
            font-size: 1.05rem;
        }
    }
</style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-0">@L["Today's Rates"]</h4>
        <div class="text-muted small">@L["Set today's rate for every fuel in one place. Each grade keeps its own rate."]</div>
    </div>
    <a asp-action="Products" asp-controller="Operations" class="btn btn-sm btn-outline-secondary">@L["Manage Products"]</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert @(Model.IsError ? "alert-danger" : "alert-success") py-2">@Model.Message</div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" asp-action="DailyRates" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label mb-1">@L["Pump"]</label>
                <select class="form-select" name="pumpId" onchange="this.form.submit()">
                    @foreach (var pump in Model.Pumps)
                    {
                        if (pump.Id == Model.PumpId)
                        {
                            <option value="@pump.Id" selected>@pump.Name</option>
                        }
                        else
                        {
                            <option value="@pump.Id">@pump.Name</option>
                        }
                    }
                </select>
            </div>
        </form>
    </div>
</div>

@if (Model.Rates.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="empty-state">
                <div class="empty-state-icon">&#128184;</div>
                <div class="empty-state-title">@L["No fuel products yet"]</div>
                <div class="empty-state-hint">
                    @L["Add your fuel grades (Petrol, Premium, E20, Diesel) under Products first. Each grade needs its own product so it can carry its own rate."]
                </div>
                <a asp-action="Products" class="btn btn-sm btn-primary mt-2">@L["Go to Products"]</a>
            </div>
        </div>
    </div>
}
else
{
    <form method="post" asp-action="SaveDailyRates" id="ratesForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PumpId" />
        <input type="hidden" asp-for="OwnerId" />

        @foreach (var group in grouped)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-light rate-card-head text-secondary">@group.Key</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 rate-table">
                            <thead>
                                <tr>
                                    <th>@L["Fuel"]</th>
                                    <th class="text-end">@L["Previous"]</th>
                                    <th class="text-end" style="width:185px;">@L["Today's Rate"]</th>
                                    <th class="text-end">@L["Change"]</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in group)
                            {
                                var i = item.index;
                                var row = item.row;
                                <tr class="rate-row" data-row="@i">
                                    <td data-cell="fuel" data-label="@L["Fuel"]">
                                        <div class="fw-semibold">@row.Name</div>
                                        <div class="text-muted small">
                                            @L["per"] @row.Unit
                                            @if (row.LastChangedOn is not null)
                                            {
                                                <span>&middot; @L["last changed"] @row.LastChangedOn.Value.ToString("dd-MMM")</span>
                                            }
                                        </div>
                                        <input type="hidden" name="Rates[@i].ProductId" value="@row.ProductId" />
                                        <input type="hidden" name="Rates[@i].OriginalRate" value="@row.OriginalRate.ToString(inv)" />
                                    </td>
                                    <td data-cell="prev" class="text-end text-muted" data-label="@L["Previous"]">
                                        @(row.PreviousRate is null ? "" : "was ₹" + row.PreviousRate.Value.ToString("0.00"))
                                    </td>
                                    <td data-cell="rate" class="text-end" data-label="@L["Today's Rate"]">
                                        <div class="input-group input-group-sm justify-content-end">
                                            <span class="input-group-text">&#8377;</span>
                                            <input type="number" step="0.01" min="0.01" required
                                                   class="form-control rate-input"
                                                   name="Rates[@i].CurrentRate"
                                                   value="@row.CurrentRate.ToString("0.00", inv)"
                                                   data-original="@row.OriginalRate.ToString("0.00", inv)" />
                                        </div>
                                    </td>
                                    <td data-cell="delta" class="text-end rate-delta text-muted" data-label="@L["Change"]">-</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="submit" class="btn btn-primary" id="saveBtn" disabled>@L["Save Today's Rates"]</button>
            <button type="button" class="btn btn-outline-secondary" id="resetBtn" disabled>@L["Undo changes"]</button>
            <span class="text-muted small" id="changeCount"></span>
        </div>
    </form>
}

@section Scripts {
<script>
    (function () {
        var form = document.getElementById('ratesForm');
        if (!form) { return; }

        var inputs   = Array.prototype.slice.call(form.querySelectorAll('.rate-input'));
        var saveBtn  = document.getElementById('saveBtn');
        var resetBtn = document.getElementById('resetBtn');
        var counter  = document.getElementById('changeCount');
        var dirty    = false;

        function refresh() {
            var changed = 0;

            inputs.forEach(function (input) {
                var original = parseFloat(input.dataset.original);
                var now      = parseFloat(input.value);
                var tr       = input.closest('tr');
                var cell     = tr.querySelector('.rate-delta');

                // Khaali ya adhoora ank par purani haalat dikhao, warna screen
                // par "NaN" jaisa kuch aa jaata hai jab user type kar raha ho.
                if (isNaN(now) || isNaN(original) || now === original) {
                    tr.classList.remove('is-changed');
                    cell.textContent = '-';
                    cell.className = 'text-end rate-delta text-muted';
                    return;
                }

                var diff = Math.round((now - original) * 100) / 100;
                if (diff === 0) {
                    tr.classList.remove('is-changed');
                    cell.textContent = '-';
                    cell.className = 'text-end rate-delta text-muted';
                    return;
                }

                changed++;
                tr.classList.add('is-changed');
                // Rate badhna pump wale ke liye buri khabar nahi hai, isliye
                // laal/hara nahi - sirf saaf ishara ki upar gaya ya neeche.
                cell.textContent = (diff > 0 ? '▲ +' : '▼ ') + diff.toFixed(2);
                cell.className = 'text-end rate-delta ' + (diff > 0 ? 'text-primary' : 'text-warning');
            });

            dirty = changed > 0;
            saveBtn.disabled  = !dirty;
            resetBtn.disabled = !dirty;
            counter.textContent = changed === 0
                ? ''
                : (changed === 1 ? '1 rate changed' : changed + ' rates changed');
        }

        inputs.forEach(function (input) { input.addEventListener('input', refresh); });

        resetBtn.addEventListener('click', function () {
            inputs.forEach(function (input) { input.value = input.dataset.original; });
            refresh();
        });

        // Galti se page chhod dene par bhare hue rate na khoyein.
        window.addEventListener('beforeunload', function (e) {
            if (!dirty) { return; }
            e.preventDefault();
            e.returnValue = '';
        });

        form.addEventListener('submit', function () {
            dirty = false;               // apna hi submit rok na de
            saveBtn.disabled = true;     // double-submit se do baar history na bane
            saveBtn.textContent = '@L["Saving..."]';
        });

        refresh();
    })();
</script>
}
