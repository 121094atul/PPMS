@model PPMS.Client.Web.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Petrol Pump Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', sans-serif;
        }

        /* Mobile par page screen se 100px chaudi ho rahi thi.

           Wajah: neeche `body.login-page::before` ek 600px ka gola hai jiska
           `right: -100px` hai — wo daayen se 100px bahar nikalta hai. body par
           `overflow: hidden` laga tha, par CSS ka niyam ye hai ki agar `html`
           ka overflow `visible` ho to viewport apna overflow BODY se utha leta
           hai — aur tab body khud `visible` maani jaati hai. Yaani wo hidden
           gole ko kaat hi nahi rahi thi.

           Nateeja: document 475px chaudi (viewport 375px), phone use zoom out
           karke dikhata tha, text daayen se kat jaata tha, aur zoom karne par
           layout aur bigad jaati thi.

           `html` par overflow-x: hidden lagate hi document wapas 375px par aa
           gaya (chala kar jaancha). */
        html {
            overflow-x: hidden;
        }

        body.login-page {
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a 0%, #0c2340 40%, #0f3460 70%, #1a1a2e 100%);
            position: relative;
            overflow: hidden;
        }

        body.login-page::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(249,115,22,0.15) 0%, transparent 70%);
            top: -150px;
            right: -100px;
            border-radius: 50%;
            pointer-events: none;
        }
        body.login-page::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, transparent 70%);
            bottom: -100px;
            left: -100px;
            border-radius: 50%;
            pointer-events: none;
        }

        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 420px;
            background: rgba(15, 23, 42, 0.92);
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 20px;
            padding: 2.5rem 2.25rem 2rem;
            box-shadow: 0 32px 64px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(249,115,22,0.08);
            margin: 1rem;
            animation: slideUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px) scale(0.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .login-logo {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #f97316, #dc2626);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 1.1rem;
            box-shadow: 0 8px 24px rgba(249,115,22,0.50), 0 0 0 4px rgba(249,115,22,0.12);
        }

        .login-title {
            color: #ffffff;
            font-size: 1.5rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 2px;
            letter-spacing: -0.3px;
        }

        .login-subtitle {
            color: rgba(255,255,255,0.50);
            font-size: 0.82rem;
            text-align: center;
            margin-bottom: 1.25rem;
            font-weight: 500;
        }

        .trial-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, rgba(16,185,129,0.20), rgba(5,150,105,0.15));
            border: 1px solid rgba(16,185,129,0.45);
            color: #34d399;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 0.45rem 1.1rem;
            border-radius: 50px;
            letter-spacing: 0.2px;
            box-shadow: 0 0 16px rgba(16,185,129,0.15);
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            transition: all 0.2s ease;
        }
        .trial-badge:hover {
            background: linear-gradient(135deg, rgba(16,185,129,0.35), rgba(5,150,105,0.28));
            border-color: rgba(16,185,129,0.75);
            box-shadow: 0 0 22px rgba(16,185,129,0.30);
            transform: translateY(-1px);
        }
        .trial-badge .dot {
            width: 7px;
            height: 7px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse-dot 1.8s ease infinite;
            flex-shrink: 0;
        }
        @@keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50%       { opacity: 0.5; transform: scale(0.7); }
        }

        .btn-features {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(59,130,246,0.12);
            border: 1px solid rgba(59,130,246,0.35);
            color: #60a5fa;
            font-size: 0.76rem;
            font-weight: 600;
            padding: 0.35rem 0.9rem;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 0.3rem;
        }
        .btn-features:hover {
            background: rgba(59,130,246,0.25);
            color: #93c5fd;
            border-color: #60a5fa;
        }

        .form-label-custom {
            color: rgba(255,255,255,0.60);
            font-size: 11.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            margin-bottom: 6px;
            display: block;
        }

        .input-wrapper {
            position: relative;
        }
        .input-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,0.35);
            font-size: 15px;
            pointer-events: none;
            z-index: 2;
        }

        .login-input {
            width: 100%;
            background: rgba(255,255,255,0.06) !important;
            border: 1.5px solid rgba(255,255,255,0.12) !important;
            border-radius: 10px !important;
            color: #ffffff !important;
            font-size: 14.5px !important;
            font-family: 'Inter', sans-serif !important;
            font-weight: 500;
            padding: 0.7rem 0.9rem 0.7rem 2.6rem !important;
            height: auto !important;
            outline: none !important;
            box-shadow: none !important;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
            -webkit-appearance: none;
            appearance: none;
            caret-color: #f97316;
        }
        .login-input::placeholder {
            color: rgba(255,255,255,0.28) !important;
            font-weight: 400;
        }
        .login-input:focus {
            background: rgba(249,115,22,0.08) !important;
            border-color: #f97316 !important;
            box-shadow: 0 0 0 3px rgba(249,115,22,0.18) !important;
            color: #ffffff !important;
        }
        .login-input:-webkit-autofill,
        .login-input:-webkit-autofill:hover,
        .login-input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px rgba(15,23,42,0.98) inset !important;
            -webkit-text-fill-color: #ffffff !important;
            border-color: rgba(255,255,255,0.18) !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, #f97316 0%, #dc2626 100%);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            padding: 0.78rem 1rem;
            cursor: pointer;
            letter-spacing: 0.3px;
            margin-top: 0.5rem;
            box-shadow: 0 4px 20px rgba(249,115,22,0.40);
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(249,115,22,0.55);
            background: linear-gradient(135deg, #fb923c 0%, #ef4444 100%);
        }
        .btn-login:active {
            transform: translateY(0);
        }

        .login-error {
            background: rgba(239,68,68,0.12);
            border: 1px solid rgba(239,68,68,0.35);
            color: #fca5a5;
            border-radius: 10px;
            font-size: 13px;
            padding: 0.6rem 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .login-footer {
            text-align: center;
            color: rgba(255,255,255,0.25);
            font-size: 11px;
            margin-top: 1.5rem;
            font-weight: 500;
        }

        /* Feature Card styling inside Feature Modal */
        .feature-box {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 1rem 1.1rem;
            margin-bottom: 0.9rem;
            transition: all 0.2s ease;
        }
        .feature-box:hover {
            background: rgba(255,255,255,0.07);
            border-color: rgba(249,115,22,0.3);
            transform: translateY(-1px);
        }
        .feature-box-title {
            color: #fb923c;
            font-size: 0.92rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .feature-box-desc {
            color: rgba(255,255,255,0.65);
            font-size: 0.8rem;
            line-height: 1.5;
            margin: 0;
        }
        /* Install wala button. `btn-features` se alag rakha hai — wo halka,
           "chahein to dekh lo" wala button hai; ye kaam ka hai, isliye thoda
           bhara hua aur poori chaudai ka. */
        .btn-install-app {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            padding: 9px 14px;
            border-radius: 10px;
            border: 1px solid rgba(249, 115, 22, 0.45);
            background: rgba(249, 115, 22, 0.12);
            color: #fdba74;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .btn-install-app:hover {
            background: rgba(249, 115, 22, 0.2);
            border-color: rgba(249, 115, 22, 0.7);
        }

        .feature-pill {
            display: inline-block;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: #e2e8f0;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 6px;
            margin: 4px 4px 0 0;
        }

        /* ══════════════════════════════════════════════════════════════
           MODAL (Trial + Features) — mobile par screen se bahar nikal
           rahe the. Wajah: card ek flex item hai aur flex item ka
           default `min-width:auto` hota hai, yaani wo apne content ke
           min-content se chhota ho hi nahi sakta. 3 plan cards aur
           phone+WhatsApp wali line 375px me nahi samati thi, isliye
           card 440px par ada rehta tha aur daayen se text kat jaata
           tha — band karne ka (X) button bhi pahunch se bahar.
           ══════════════════════════════════════════════════════════════ */
        .ppms-modal-card {
            /* Ye do line asli fix hai: ab card sach me sikud sakta hai. */
            min-width: 0;
            max-width: min(540px, 100%);
        }

        #trialModal .ppms-modal-card { max-width: min(440px, 100%); }

        /* Lambe modal ko upar se shuru karo, warna chhoti screen par
           header hi upar kat jaata hai aur scroll karke wapas nahi
           aa sakte. */
        .ppms-modal {
            /* !important isliye: har modal ke apne tag par INLINE
               `align-items:center` likha hai, aur inline style stylesheet ko
               hamesha dabaa deta hai. Isi wajah se pehle ki koshishein bekaar
               gayi thin — modal ab bhi center hi ho raha tha aur uska upar ka
               hissa screen ke bahar reh jaata tha (naap kar dekha: top -1042px). */
            align-items: flex-start !important;

            /* Pehle yahan overflow-x: hidden tha. Wo us waqt laga tha jab card
               screen se bahar nikal jaata tha — ab wo dikkat nahi hai (card
               min-width:0 + max-width:100% se sikud jaata hai; 320px par bhi
               poora samata hai, naap kar dekha).

               Par zoom karne par wahi 'hidden' ulta pad raha tha: modal
               position:fixed hai, to pinch-zoom me uska daayan hissa screen se
               bahar chala jaata tha AUR hidden ki wajah se use kheench kar
               dekha bhi nahi ja sakta tha — bas kata hua dikhta tha.
               'auto' se ab zoom karke bhi poora padha ja sakta hai. */
            overflow-x: auto;
        }

        /* Yahan pehle `align-items: center` tha (720px se lambi screen par).
           Wahi asli dikkat thi:

           Flex container me item ko center karo aur item container se LAMBA ho
           jaye, to wo dono taraf barabar bahar nikalta hai — upar wala hissa
           screen ke UPAR chala jaata hai, aur browser wahan scroll karne hi
           nahi deta (scroll sirf neeche ki taraf chalta hai). Nateeja: features
           modal ka header aur X button dikhte hi nahi the, aur upar khinchne
           par bhi kuch nahi aata tha.

           Mobile par `.ppms-modal-scroll` ka max-height hata diya jaata hai
           (taaki andar do scrollbar na banein), isliye modal aur lamba ho jaata
           hai — aur ye bug wahin sabse zyada dikhta tha.

           Ab centering `align-items` se nahi, card ke `margin: auto` se hoti
           hai. Jagah ho to card beech me aa jaata hai; na ho to upar se shuru
           hota hai aur poora scroll ho jaata hai. Kuch kabhi kata nahi rehta. */
        .ppms-modal-card {
            /* `margin: auto` bhi kaam nahi aaya — jab item container se lamba ho
               to auto margin RINAATMAK ho jaata hai aur upar ka hissa phir bahar
               chala jaata hai (naap kar dekha: card ka top -1042px par tha).

               Isliye centering poori tarah hata di. Modal hamesha upar se shuru
               hota hai. Chhota modal thoda upar dikhega — par kuch bhi kabhi
               kata nahi rahega, aur X button hamesha haath me rahega. */
            margin-top: 0 !important;
            margin-bottom: 1rem !important;
        }

        /* Andar ka scrollbar dark theme me safed patti jaisa chubhta
           tha — ab background ke saath ghul jaata hai. */
        .ppms-modal-scroll::-webkit-scrollbar { width: 8px; }
        .ppms-modal-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .ppms-modal-scroll::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.18);
            border-radius: 8px;
        }
        .ppms-modal-scroll::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.30);
        }
        .ppms-modal-scroll {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.18) transparent;
        }

        @@media screen and (max-width: 575.98px) {
            .ppms-modal { padding: 0.5rem; }

            .ppms-modal-card {
                border-radius: 16px;
                margin: 0.5rem auto !important;
            }

            /* Header ka bada text chhoti screen par do line le leta tha
               aur X button ke neeche chala jaata tha. */
            .ppms-modal-card h1,
            .ppms-modal-card .modal-head-title { font-size: 1.05rem !important; }

            /* Teen plan side-by-side me "1 Year" kat jaata tha. */
            .ppms-plan-grid { grid-template-columns: 1fr 1fr !important; }
            .ppms-plan-grid > :last-child { grid-column: 1 / -1; }

            /* Phone number aur WhatsApp button ek line me nahi samate. */
            .ppms-contact-row { flex-direction: column; align-items: stretch !important; }
            .ppms-contact-row > a { justify-content: center; }

            /* Feature ke pills lambe naam par bahar nikal jaate the. */
            .feature-pill { white-space: normal; }

            .ppms-modal-scroll {
                padding: 1rem 1rem 1.2rem !important;
                max-height: none !important;
            }
        }

        @@media screen and (max-width: 359.98px) {
            .ppms-plan-grid { grid-template-columns: 1fr !important; }
            .ppms-plan-grid > :last-child { grid-column: auto; }
        }
    </style>
    @* ---- PWA ----
       Ye page Layout = null par chalta hai, isliye _Layout waale PWA tags yahan
       apne aap nahi aate. Aur yahi PEHLA page hai jahan user aata hai — agar
       yahan manifest na ho to Chrome ko app "installable" dikhti hi nahi aur
       "Install app" ka option kabhi nahi aata. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="PPMS" />
</head>
<body class="login-page">
    <div class="login-card">

        @* ---- App install ----
           Sabse upar hai kyunki nazar pehle yahin padti hai, aur ye pehli baar
           aane wale ke liye sabse kaam ki cheez hai.

           Chrome khud se koi popup nahi dikhata (desktop par sirf address bar me
           chhota icon, jo kisi ko dikhta hi nahi), isliye apna button de rahe hain.

           Ye shuru me CHHUPA rehta hai aur teen soorat me kabhi nahi dikhta:
             * app pehle se install ho (display-mode: standalone)
             * browser install support hi na karta ho
             * install ho jaane ke baad (appinstalled) — turant gayab ho jaata hai
           Yaani jiske phone me app lag chuki hai use ye dobara kabhi nahi dikhega. *@
        <div id="installBar" style="display:none; margin-bottom:14px;">
            <button type="button" id="btnInstallApp" class="btn-install-app" title="@L["Install PPMS on this phone"]">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                @L["Get the mobile app"]
            </button>
            <div id="iosInstallHint" style="display:none; font-size:11px; color:#94a3b8; margin-top:6px; text-align:center;">
                On iPhone: tap <strong>Share</strong> at the bottom, scroll down and tap <strong>Add to Home Screen</strong>.
            </div>
        </div>

        <!-- Logo -->
        <div class="login-logo">&#9981;</div>
        <h1 class="login-title">@L["Petrol Pump Portal"]</h1>
        <p class="login-subtitle">@L["Management System &bull; Secure Access"]</p>

        <!-- Buttons Header: 7 Days Trial & Explore Features -->
        <div class="text-center mb-4">
            <button type="button" class="trial-badge mb-2" onclick="openTrialModal()" title="@L["Click to Request 7-Day Free Trial"]">
                <span class="dot"></span>
                @L["7 Days Free Trial Available"]
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:4px;opacity:0.7"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </button>
            <br />
            <button type="button" class="btn-features" onclick="openFeaturesModal()" title="@L["View All Software Features & Modules"]">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                @L["Explore All Software Features"]
            </button>

        </div>

        <!-- Error Message -->
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="login-error">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                @* Sandesh aur number ek hi khaane me - .login-error flex hai, alag-alag
                   rakhne par number sandesh ke bagal me dab jaata tha. *@
                <div>
                @Model.ErrorMessage
                @if (Model.ErrorCode is "TRIAL_EXPIRED" or "OWNER_SUSPENDED")
                {
                    @* Plan khatam hua owner kya kare - yahi sabse zaroori baat hai. Number
                       wahi jo neeche "OTP nahi aaya?" me hai. *@
                    <div style="margin-top:6px;"><a href="tel:6394389973" style="color:#fcd34d; font-weight:700;">📞 6394389973</a></div>
                }
                </div>
            </div>
        }

        <!-- Login Form -->
        <form method="post" asp-action="Login" asp-controller="Account" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label-custom">@L["Username"]</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    </span>
                    <input asp-for="Username"
                           class="login-input"
                           autocomplete="username"
                           placeholder="@L["Enter your username"]"
                           spellcheck="false" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">@L["Password"]</label>
                <div class="input-wrapper">
                    <span class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    </span>
                    <input asp-for="Password"
                           id="passwordInput"
                           type="password"
                           class="login-input"
                           autocomplete="current-password"
                           placeholder="@L["Enter your password"]"
                           style="padding-right:2.8rem !important;" />
                    <button type="button" id="togglePassword" onclick="togglePasswordVisibility()"
                            title="@L["Show/Hide Password"]"
