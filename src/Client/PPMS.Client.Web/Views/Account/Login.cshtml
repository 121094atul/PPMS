                    <div class="feature-box-desc">
                        @L["Every litre accounted for, with the loss shown in rupees — not just litres."]
                    </div>
                    <div style="margin-top:6px;">
                        <span class="feature-pill">@L["&#128207; Fuel dip &amp; water dip"]</span>
                        <span class="feature-pill">@L["&#128201; Variance in litres and &#8377;"]</span>
                        <span class="feature-pill">@L["&#128666; Tanker purchase entry"]</span>
                        <span class="feature-pill">@L["&#128721; Wrong-tank entry blocked"]</span>
