                <!-- 7. Staff -->
                <div class="feature-box">
                    <div class="feature-box-title">
                        <span>&#128101;</span> Staff &amp; Expenses
                    </div>
                    <div class="feature-box-desc">
                        @L["Your people and your day-to-day spending, in the same place as everything else."]
                    </div>
                    <div style="margin-top:6px;">
                        <span class="feature-pill">@L["&#128100; Employee records"]</span>
                        <span class="feature-pill">@L["&#128176; Monthly salary payment"]</span>
                        <span class="feature-pill">@L["&#128221; Operating expenses"]</span>
                        <span class="feature-pill">@L["&#128193; Head-wise categories"]</span>
