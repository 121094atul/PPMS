                    <div class="feature-box-desc">
                        @L["Normal, Premium (XP95), E20, Diesel — each grade keeps its own rate, and each nozzle bills at its own."]
                    </div>
                    <div style="margin-top:6px;">
                        <span class="feature-pill">@L["&#127749; All fuels on one screen"]</span>
                        <span class="feature-pill">@L["&#128200; Shows what moved up or down"]</span>
