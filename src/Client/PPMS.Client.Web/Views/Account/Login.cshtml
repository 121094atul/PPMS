                        @L["Built for the person standing at the pump, not for a computer operator."]
                    </div>
                    <div style="margin-top:6px;">
                        <span class="feature-pill">@L["&#127760; English &amp; &#2361;&#2367;&#2306;&#2342;&#2368;"]</span>
                        <span class="feature-pill">@L["&#128241; Works on a phone"]</span>
                        <span class="feature-pill">@L["&#128214; Manual built in (download / print)"]</span>
                        <span class="feature-pill">@L["&#9989; Step-by-step setup on day one"]</span>
                        <span class="feature-pill">@L["&#128424; Print-ready registers"]</span>
                    </div>
                </div>

                <!-- Bottom Action -->
                <div style="display:flex; gap:0.75rem; margin-top:1.2rem;">
                    <button onclick="closeFeaturesModal(); openTrialModal();" style="flex:1; background:linear-gradient(135deg,#10b981,#059669); border:none; border-radius:10px; color:#fff; font-size:14px; font-weight:700; padding:0.75rem; cursor:pointer;">
                        Start 7-Day Free Trial &rarr;
                    </button>
                    <button onclick="closeFeaturesModal()" style="flex:0 0 auto; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.14); border-radius:10px; color:rgba(255,255,255,0.7); font-size:14px; padding:0.75rem 1.2rem; cursor:pointer;">
                        @L["Close"]
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        var selectedModalPlan = '7_DAY_TRIAL';

        function openTrialModal() {
            document.getElementById('trialModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
            toggleSignupFields();
        }

        function closeTrialModal() {
            document.getElementById('trialModal').style.display = 'none';
            document.body.style.overflow = '';
            document.getElementById('modalFormView').style.display = 'block';
            document.getElementById('modalSuccessView').style.display = 'none';
            document.getElementById('modalName').value = '';
            document.getElementById('modalPhone').value = '';
            document.getElementById('modalPump').value = '';
            document.getElementById('modalFormError').style.display = 'none';
            validateModalForm();
        }

        // ── Password bhool gaye ─────────────────────────────────────────────
        function openForgotModal() {
            backToStep1();
            document.getElementById('forgotModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeForgotModal() {
            document.getElementById('forgotModal').style.display = 'none';
            document.body.style.overflow = '';
            backToStep1();
        }

        function backToStep1() {
            document.getElementById('forgotStep1').style.display = 'block';
            document.getElementById('forgotStep2').style.display = 'none';
            document.getElementById('forgotStep3').style.display = 'none';
            document.getElementById('forgotOtp').value = '';
            document.getElementById('forgotPass').value = '';
            document.getElementById('forgotPass2').value = '';
            hideMsg('forgotMsg1');
            hideMsg('forgotMsg2');
        }

        function showMsg(id, text, isError) {
            var el = document.getElementById(id);
            el.textContent = text;
            el.style.color = isError ? '#fca5a5' : '#86efac';
            el.style.display = 'block';
        }

        function hideMsg(id) {
            document.getElementById(id).style.display = 'none';
        }

        function sendOtp() {
            var mobile = document.getElementById('forgotMobile').value.replace(/\D/g, '');
            if (mobile.length < 10) {
                showMsg('forgotMsg1', 'Enter the complete mobile number.', true);
                return;
            }

            var btn = document.getElementById('sendOtpBtn');
            btn.disabled = true;
            btn.textContent = '@L["Sending..."]';
            hideMsg('forgotMsg1');

            fetch('/Account/ForgotPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mobile: mobile })
            })
            .then(function (r) {
                // Server hamesha safal lautata hai - number registered ho ya na ho.
                // Isliye yahan bhi dono soorat me step 2 par le jaate hain.
                if (r.status === 429) {
                    showMsg('forgotMsg1', 'Too many attempts. Please try again later.', true);
                    return null;
                }
                return r.json().catch(function () { return {}; });
            })
            .then(function (data) {
                if (data === null) { return; }

                // SMS ka intezaam hi na ho to OTP ki screen kholna bekaar hai —
                // wo kabhi aayega hi nahi. Server saaf batata hai (ye poore system
                // ki haalat hai, kisi khaas number ki nahi, isliye batana surakshit).
                if (data.smsAvailable === false) {
                    showMsg('forgotMsg1', data.message || 'OTP service is not set up. Please call 6394389973.', true);
                    return;
                }

                document.getElementById('forgotStep1').style.display = 'none';
                document.getElementById('forgotStep2').style.display = 'block';
                document.getElementById('forgotOtp').focus();
            })
            .catch(function () {
                showMsg('forgotMsg1', 'Something went wrong. Please try again.', true);
            })
            .finally(function () {
                btn.disabled = false;
                btn.textContent = '@L["Send OTP"]';
            });
        }

        function submitReset() {
            var mobile = document.getElementById('forgotMobile').value.replace(/\D/g, '');
            var otp = document.getElementById('forgotOtp').value.trim();
            var pass = document.getElementById('forgotPass').value;
            var pass2 = document.getElementById('forgotPass2').value;

            if (otp.length !== 6) {
                showMsg('forgotMsg2', 'Enter the 6-digit OTP.', true);
                return;
            }
            if (pass.length < 6) {
                showMsg('forgotMsg2', 'Password must be at least 6 characters.', true);
                return;
            }
            // Server par bhi jaanch hoti hai, lekin yahan rok dene se user ko
            // ek galat OTP koshish bachti hai (sirf 5 milti hain).
            if (pass !== pass2) {
                showMsg('forgotMsg2', 'The two passwords do not match.', true);
                return;
            }

            var btn = document.getElementById('resetBtn');
            btn.disabled = true;
            btn.textContent = '@L["Changing..."]';
            hideMsg('forgotMsg2');

            fetch('/Account/ResetPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mobile: mobile, otp: otp, newPassword: pass })
            })
            .then(function (r) {
                return r.json().catch(function () { return {}; }).then(function (d) {
                    return { ok: r.ok, data: d };
                });
            })
            .then(function (res) {
                if (res.ok) {
                    document.getElementById('forgotStep2').style.display = 'none';
                    document.getElementById('forgotStep3').style.display = 'block';
                } else {
                    showMsg('forgotMsg2', res.data.message || 'Could not reset the password.', true);
                }
            })
            .catch(function () {
                showMsg('forgotMsg2', 'Something went wrong. Please try again.', true);
            })
            .finally(function () {
                btn.disabled = false;
                btn.textContent = '@L["Change password"]';
            });
        }

        function openFeaturesModal() {
            document.getElementById('featuresModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeFeaturesModal() {
            document.getElementById('featuresModal').style.display = 'none';
            document.body.style.overflow = '';
        }

        /* Modal ke bahar (kaale hisse par) click karne se band ho — phone par
           X button chhota padta hai, aur log yahi umeed karte hain. Click seedha
           overlay par hi hona chahiye, andar ke card par nahi. */
        ['trialModal', 'featuresModal', 'forgotModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('click', function (e) {
                if (e.target !== el) return;
                if (id === 'trialModal') { closeTrialModal(); }
                else if (id === 'forgotModal') { closeForgotModal(); }
                else { closeFeaturesModal(); }
            });
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            var t = document.getElementById('trialModal');
            var f = document.getElementById('featuresModal');
            if (t && t.style.display === 'flex') { closeTrialModal(); }
            if (f && f.style.display === 'flex') { closeFeaturesModal(); }
            var g = document.getElementById('forgotModal');
            if (g && g.style.display === 'flex') { closeForgotModal(); }
        });

        function selectModalPlan(plan, el) {
            selectedModalPlan = plan;
            document.querySelectorAll('.modal-plan-card').forEach(c => {
                c.style.borderColor = 'rgba(255,255,255,0.25)';
                c.style.background = 'rgba(255,255,255,0.06)';
            });
            el.style.borderColor = plan === '7_DAY_TRIAL' ? '#10b981' : (plan === '6_MONTH' ? '#60a5fa' : '#c084fc');
            el.style.background = plan === '7_DAY_TRIAL' ? 'rgba(16,185,129,0.15)' : (plan === '6_MONTH' ? 'rgba(59,130,246,0.15)' : 'rgba(168,85,247,0.15)');

            // Trial par account yahin banta hai, isliye username/password ke khaane
            // dikhane hain. Paid plan par sirf request jaati hai.
            toggleSignupFields();
        }

        function validateModalForm() {
            var name = document.getElementById('modalName').value.trim();
            var phone = document.getElementById('modalPhone').value.trim();
            var isValid = name.length >= 2 && /^[6-9]\d{9}$/.test(phone);

            // Trial me account yahin banta hai, to pump ka naam, username aur
            // password teeno chahiye - warna login kis se karenge.
            if (typeof isTrialSelected === 'function' && isTrialSelected()) {
                var pump = document.getElementById('modalPump').value.trim();
                var u = document.getElementById('modalUsername');
                var p = document.getElementById('modalPassword');
                isValid = isValid && pump.length >= 3 &&
                          u && u.value.trim().length >= 4 &&
                          p && p.value.length >= 6;
            }

            var btn = document.getElementById('modalSubmitBtn');
            btn.disabled = !isValid;
            btn.style.opacity = isValid ? '1' : '0.5';
        }

        // Trial par account TURANT ban jaata hai; paid plan par abhi sirf request
        // jaati hai (payment gateway nahi hai). Isliye do alag raaste.
        function isTrialSelected() {
            return selectedModalPlan === '7_DAY_TRIAL';
        }

        function toggleSignupFields() {
            var box = document.getElementById('signupFields');
            if (box) { box.style.display = isTrialSelected() ? 'block' : 'none'; }

            var txt = document.getElementById('modalSubmitText');
            if (txt) {
                txt.textContent = isTrialSelected()
                    ? 'Create account & start trial'
                    : 'Send request';
            }
            validateModalForm();
        }

        function submitModalRequest() {
            if (isTrialSelected()) {
                submitSignup();
            } else {
                submitPlanRequest();
            }
        }

        function modalError(text) {
            var el = document.getElementById('modalFormError');
            el.style.display = 'block';
            el.textContent = text;
        }

        function submitSignup() {
            var name = document.getElementById('modalName').value.trim();
            var phone = document.getElementById('modalPhone').value.replace(/\D/g, '');
            var pump = document.getElementById('modalPump').value.trim();
            var username = document.getElementById('modalUsername').value.trim();
            var password = document.getElementById('modalPassword').value;

            if (!name || phone.length < 10 || !pump) {
                modalError('Name, 10-digit mobile and pump name are all required.');
                return;
            }
            if (username.length < 4) {
                modalError('Username must be at least 4 characters.');
                return;
            }
            if (password.length < 6) {
                modalError('Password must be at least 6 characters.');
                return;
            }

            var btn = document.getElementById('modalSubmitBtn');
            var txt = document.getElementById('modalSubmitText');
            btn.disabled = true;
            txt.textContent = '@L["Creating account..."]';
            document.getElementById('modalFormError').style.display = 'none';

            fetch('/Account/Signup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    pumpName: pump, contactName: name, contactNo: phone,
                    username: username, password: password, city: null, stateCode: null, email: null
                })
            })
            .then(function (r) {
                return r.json().catch(function () { return {}; }).then(function (d) {
                    return { ok: r.ok, data: d };
                });
            })
            .then(function (res) {
                if (res.ok) {
                    document.getElementById('modalFormView').style.display = 'none';
                    document.getElementById('modalSuccessView').style.display = 'block';
                    var head = document.getElementById('successHeadline');
                    var sub = document.getElementById('successSubline');
                    if (head) { head.textContent = '@L["Account created!"]'; }
                    if (sub) { sub.textContent = 'Username "' + username + '" - your 7-day trial has started.'; }
                } else {
                    modalError(res.data.message || 'Could not create the account. Please call 6394389973.');
                    btn.disabled = false;
                    toggleSignupFields();
                }
            })
            .catch(function () {
                modalError('Network problem. Please call 6394389973.');
                btn.disabled = false;
                toggleSignupFields();
            });
        }

        function submitPlanRequest() {
            var name = document.getElementById('modalName').value.trim();
            var phone = document.getElementById('modalPhone').value.trim();
            var pump = document.getElementById('modalPump').value.trim();
            if (!name || !phone) { return; }

            var btn = document.getElementById('modalSubmitBtn');
            var txt = document.getElementById('modalSubmitText');
            btn.disabled = true;
            txt.textContent = '@L["Sending request..."]';

            fetch('/Account/SubmitSubscriptionRequest', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contactName: name, contactNo: phone,
                    planType: selectedModalPlan, ownerId: null, pumpName: pump
                })
            })
            .then(function (r) {
                if (r.ok) {
                    document.getElementById('modalFormView').style.display = 'none';
                    document.getElementById('modalSuccessView').style.display = 'block';
                } else {
                    modalError('Could not send the request. Please call 6394389973.');
                    btn.disabled = false;
                    toggleSignupFields();
                }
            })
            .catch(function () {
                modalError('Network problem. Please call 6394389973.');
                btn.disabled = false;
                toggleSignupFields();
            });
        }

        document.querySelector('form').addEventListener('submit', function () {
            const btn = document.getElementById('loginBtn');
            const text = document.getElementById('btnText');
            const spinner = document.getElementById('btnSpinner');
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.8';
            text.textContent = '@L["Signing In..."]';
            spinner.classList.remove('d-none');
        });

        function togglePasswordVisibility() {
            var input = document.getElementById('passwordInput');
            var eyeOn  = document.getElementById('eyeIcon');
            var eyeOff = document.getElementById('eyeOffIcon');
            var btn    = document.getElementById('togglePassword');

            if (input.type === 'password') {
                input.type = 'text';
                eyeOn.style.display  = 'none';
                eyeOff.style.display = 'block';
                btn.style.color = 'rgba(249,115,22,0.80)';
            } else {
                input.type = 'password';
                eyeOn.style.display  = 'block';
                eyeOff.style.display = 'none';
                btn.style.color = 'rgba(255,255,255,0.38)';
            }
        }
    </script>
    <script>
        // Service worker yahin se register ho jaata hai — user ko login karne ka
        // intezaar nahi karna padta.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function () { });
            });
        }
    
        // ---- App install button ----
        // Browser tabhi bolta hai jab sab shart poori hon (https, manifest,
        // service worker, icons). Event pakad kar rakh lete hain, warna wo
        // ek baar aakar chala jaata hai aur phir kabhi nahi milta.
        (function () {
            var deferred = null;
            var btn = document.getElementById('btnInstallApp');
            var bar = document.getElementById('installBar');
            var hint = document.getElementById('iosInstallHint');
            if (!btn) { return; }

            // Pehle se install hai to kuch mat dikhao.
            var installed = window.matchMedia('(display-mode: standalone)').matches
                         || window.navigator.standalone === true;

            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();          // Chrome ki apni chhoti patti rok do
                deferred = e;
                if (!installed && bar) { bar.style.display = 'block'; }
            });

            btn.addEventListener('click', function () {
                if (!deferred) { return; }
                deferred.prompt();
                deferred.userChoice.then(function () {
                    deferred = null;
                    if (bar) { bar.style.display = 'none'; }
                });
            });

            // Install hote hi button hamesha ke liye gayab.
            window.addEventListener('appinstalled', function () {
                if (bar) { bar.style.display = 'none'; }
            });

            // iPhone/iPad: wahan beforeinstallprompt hota hi nahi, par
            // "Add to Home Screen" chalta hai — sirf raasta batana padta hai.
            // Naya iPad khud ko "Macintosh" batata hai, isliye touch points bhi dekhte hain.
            var isIos = /iphone|ipad|ipod/i.test(navigator.userAgent)
                     || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
            // iPhone/iPad par Apple kisi website ko ek-click install karne nahi
            // deta — `beforeinstallprompt` wahan hota hi nahi. Pehle yahan sirf
            // ek line dikhati thi aur button gayab rehta tha, jisse lagta tha ki
            // iPhone par ye suvidha hai hi nahi.
            //
            // Ab button wahan bhi dikhta hai — bas dabane par install ke bajaye
            // tarika khulta hai. Jhooth nahi bola ja raha: "Add to Home Screen"
            // se app usi tarah lagti hai, bas do tap zyada lagte hain.
            if (isIos && !installed && hint && bar) {
                bar.style.display = 'block';
                btn.style.display = '';
                btn.addEventListener('click', function () {
                    hint.style.display = hint.style.display === 'block' ? 'none' : 'block';
                });
            }
        })();
</script>
