<?xml version="1.0" encoding="utf-8"?>
<!--
  Ye file publish output me chali jaati hai (dotnet publish ise generate nahi
  karta agar pehle se ho to overwrite bhi nahi karta).

  hostingModel="outofprocess" jaanbujh kar hai, inprocess nahi.

  Shared hosting (HostingRaja) par client (ppms) aur API (ppmsapi) DONO ek hi
  IIS Application Pool me chalte hain, aur alag pool lene ka option hosting plan
  me band hai. Us ek pool me:

    * dono inprocess  -> HTTP Error 500.35 (multiple apps in the same app pool)
    * ek inprocess, ek outofprocess -> HTTP Error 500.34 (mixing hosting models)
    * DONO outofprocess -> chalta hai

  Isliye API aur Client dono ki web.config me ye outofprocess hi rehna chahiye.
  Ek badla aur doosra bhool gaye to 500.34 aa jayega.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\PPMS.Client.Web.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="outofprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
